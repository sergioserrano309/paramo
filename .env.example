# -----------------------------------------------------------------------------
# Páramo Snacks — variables de entorno
# Copia este archivo a `.env.local` (o `.env`) y rellena los valores reales.
# Nunca commitees `.env` / `.env.local` con secretos.
# -----------------------------------------------------------------------------

# URL del proyecto Supabase (Settings → API). Necesaria en cliente y servidor.
# Prefijo NEXT_PUBLIC_ porque Auth en el navegador la usa para iniciar sesión.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Anon / publishable key de Supabase (Settings → API). Es pública por diseño,
# pero en este proyecto el navegador NO consulta datos de negocio con ella:
# todo el CRM pasa por API routes con service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Service role key (Settings → API → service_role). SOLO servidor.
# Bypasea RLS. NUNCA uses el prefijo NEXT_PUBLIC_ (se filtraría al bundle).
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# URL base de la app (redirects, links absolutos). En local suele ser:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Operación Auth (Hito 1) ---
# 1) Aplica supabase/migrations/20261022153000_crear_profiles.sql en tu proyecto.
# 2) Crea usuarios en Authentication → Users.
# 3) El trigger crea profiles con rol=comercial.
# 4) Para supervisor: UPDATE public.profiles SET rol = 'supervisor' WHERE email = '...';
